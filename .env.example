# Docker Compose reads .env automatically; native Go commands need exported variables.
OLLAMA_MODEL=rag29-baseline-8b
WEB_PORT=8081
CHAT_TIMEOUT=5m
# For native Go execution only. Compose uses http://ollama:11434.
OLLAMA_BASE_URL=http://127.0.0.1:11434
WEB_ADDR=127.0.0.1:8081

# Local BM25 RAG. No embedding model or cloud credentials required.
RAG_STRATEGY=structured
RAG_TOP_K_BEFORE=10
RAG_TOP_K_AFTER=4
RAG_MIN_COVERAGE=0.22
RAG_CONTEXT_CHARACTERS=5000
# Native execution only; Docker paths are configured in compose.yaml.
RAG_INDEX_PATH=documents/chunks.json
RAG_REPORT_PATH=artifacts/rag28/comparison.json

# llama-server prompt cache cap (MiB), prevents growth to the 8 GiB default.
OLLAMA_PROMPT_CACHE_MIB=512

# Reproducible task 29 profile; API can select baseline for comparison.
RAG_PROFILE=baseline
OPTIMIZATION_REPORT_PATH=artifacts/optimization29/comparison.json
